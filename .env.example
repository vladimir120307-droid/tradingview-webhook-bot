# ============================================
# TradingView Webhook Bot - Environment Config
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Webhook Security ---
WEBHOOK_SECRET=change_me_to_a_strong_random_string

# --- Binance ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# --- Bybit ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# --- OKX ---
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=false

# --- Telegram Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Discord Notifications ---
DISCORD_WEBHOOK_URL=

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
